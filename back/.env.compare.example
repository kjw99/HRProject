# Optional reference for docker-compose.compare.yml.
# The existing .env can be used as-is if it already contains these values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME

JWT_SECRET_KEY=change-me-for-local-compare
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

INITIAL_ADMIN_EMAIL=admin@test.com
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_NAME=Admin

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Optional. Required only for AI/mail scenarios.
LLM_PROVIDER=
LLM_MODEL=
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASS=
